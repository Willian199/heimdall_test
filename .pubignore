# Local and generated files do not belong in the published archive.
/.dart_tool/
/build/
/coverage/
/*.log
/pubspec.lock

# Tests need their fixtures, so exclude the complete test tree together.
/test/

# Repository-only resources.
/skills/
/tool/
/.agents/
/.codex/
/.github/
/.gitlab/
/.gitlab-ci.yml
/.aws/
/.idea/
/.vscode/
